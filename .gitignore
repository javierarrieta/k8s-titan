# ggshield local scan cache. This repo deliberately ships NO .gitguardian.yaml: the
# current secret-detection engine (2.173.0) was verified clean on SOPS ciphertext, and
# an ignore list would only hide real findings. See spec §0.1.
.cache_ggshield
.gitguardian.yaml

# Decrypted manifests must never be staged. `sops -d file.yaml > file.yaml` is a
# real way to commit plaintext secrets.
**/.decrypted*.yaml

# Plaintext staging for `sops --encrypt --in-place`: sops selects recipients by the
# file's own path, so the plaintext must sit under apply/10-secrets/ briefly. The name
# is ignored so `git add -A` cannot stage it. See docs/ovh-dns-credential.md.
apply/10-secrets/.staging.*.yaml

# Age private keys live outside this repo: ~/.config/sops/age/ and the password
# manager. Belt-and-braces in case one is ever dropped next to a manifest.
*.agekey
*.age

# OpenTofu working state from `tofu validate`. Not committed on purpose: tofu writes its lock
# file against registry.opentofu.org, while coder runs Terraform, which resolves from
# registry.terraform.io. A lock file from the wrong registry is an init failure at template push.
# Re-run `tofu init && tofu validate` in the template directory to reproduce the check.
coder/templates/**/.terraform/
coder/templates/**/.terraform.lock.hcl

# Compiled Python. The gate tools are plain scripts under tools/, so running `make check`
# drops a __pycache__ next to them; one got committed via `git add -A` and then every later
# `make check` showed a dirty tree. Artifacts are not source.
__pycache__/
*.pyc
